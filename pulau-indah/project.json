 "lines": [
  {"id": "hook1", "gap": 0.12, "text": "[serious] Rumah teres {freehold|FREEHOLD} di Pulau Indah, [b] harga bawah {tiga ratus ribu|RM300K}."},
  {"id": "hook2", "gap": 0.3, "text": "[curious] Masih wujud ke?"},
  {"id": "ans", "gap": 0.38, "text": "[confident] Wujud. [b] Dan saya tengah berdiri depan dia sekarang."},
  {"id": "loc1", "gap": 0.45, "text": "[warm] Projek perumahan baru, di Persiaran Masjid Sultan, Pulau Indah."},
  {"id": "loc2", "gap": 0.28, "text": "Sekolah, masjid, klinik, semua dekat. Halal Hub dan kawasan industri, sebelah je."},
  {"id": "loc3", "gap": 0.3, "text": "[upbeat] Nak keluar? {Kesas|KESAS}, {S.K.V.E|SKVE}, {W-C-E|WCE}, semua dah sedia."},
  {"id": "lot", "gap": 0.5, "text": "[confident] Teres setingkat. Tanah {dua puluh kali enam puluh empat|20' x 64'} kaki. Porch, muat dua kereta."},
  {"id": "liv", "gap": 0.3, "text": "[impressed] Masuk je, ruang tamu memanjang. Lapang."},
  {"id": "mbr", "gap": 0.3, "text": "Bilik utama, siap dengan bilik air sendiri."},
  {"id": "kit", "gap": 0.3, "text": "Dapur dan ruang makan di belakang, terpisah dari ruang tamu. [warm] Lebih privasi."},
  {"id": "rooms", "gap": 0.3, "text": "Tiga bilik tidur, dua bilik air. Cukup untuk satu keluarga."},
  {"id": "eta", "gap": 0.35, "text": "[serious] Struktur dah siap. Dijangka siap sepenuhnya, {suku ketiga dua ribu dua puluh tujuh|Q3 2027}."},
  {"id": "price", "gap": 0.55, "text": "[serious] Harga asal, {dua ratus sembilan puluh sembilan ribu lima ratus|RM299,500}. [b] [excited] Sekarang, dari {dua ratus sembilan puluh ribu lima ratus ringgit|RM290,500} je!"},
  {"id": "pkg", "gap": 0.65, "text": "[excited] Booking, {lima ratus ringgit|RM500}. Legal fee {S.P.A|SPA}, legal fee loan, duti setem, {M.O.T|MOT}, [b] semua percuma!"},
  {"id": "cash", "gap": 0.35, "text": "[excited] Pembeli terawal, dapat cashback {sebelas ribu ringgit|RM11,000}!"},
  {"id": "cta", "gap": 0.5, "text": "[serious] Freehold. {Ri-zab Melayu|Rizab Melayu}. Unit terhad. [b] [urgent] WhatsApp saya sekarang, {kosong satu enam, tiga tujuh kosong, lapan sembilan kosong lapan|016-370 8908}."}
