 "segments": [
  {
   "id": "hook-a",
   "start": 0.0,
   "end": 2.02,
   "text": "Selalunya orang kita ni"
  },
  {
   "id": "hook-b",
   "start": 2.02,
   "end": 3.62,
   "text": "nak jaga aurat,"
  },
  {
   "id": "hook-c",
   "start": 3.62,
   "end": 5.34,
   "text": "okey lah untuk rumah ni."
  },
  {
   "id": "intro-a",
   "start": 5.34,
   "end": 6.26,
   "text": "Hai, Assalamualaikum."
  },
  {
   "id": "intro-b",
   "start": 6.26,
   "end": 8.18,
   "text": "Saya sekarang ni di Jalan Nenas, Meru."
  },
  {
   "id": "intro-c",
   "start": 8.18,
   "end": 10.68,
   "text": "Nak site visit satu"
  },
  {
   "id": "intro-d",
   "start": 10.68,
   "end": 12.16,
   "text": "projek perumahan baru ni."
  },
  {
   "id": "intro-e",
   "start": 12.16,
   "end": 14.68,
   "text": "Dia ada teres setingkat dengan semi-D."
  },
  {
   "id": "intro-f",
   "start": 14.68,
   "end": 16.21,
   "text": "Jom kita tengok teres setingkat."
  },
  {
   "id": "est",
   "start": 16.21,
   "end": 17.51,
   "text": ""
  },
  {
   "id": "spec",
   "start": 17.51,
   "end": 20.05,
   "text": "Teres setingkat ni ada 4 bilik tidur dan 2 bilik air."
  },
  {
   "id": "spec-lot",
   "start": 20.05,
   "end": 21.650000000000002,
   "text": ""
  },
  {
   "id": "living-a",
   "start": 21.650000000000002,
   "end": 23.05,
   "text": "Ini kawasan living hall dia."
  },
  {
   "id": "living-b",
   "start": 23.05,
   "end": 25.19,
   "text": "Ceiling tinggi, 15 kaki."
  },
  {
   "id": "living-c",
   "start": 25.19,
   "end": 29.11,
   "text": "Ada tingkap untuk ventilation, sliding door."
  },
  {
   "id": "bed-a",
   "start": 29.11,
   "end": 30.61,
   "text": "Ni master bedroom dia."
  },
  {
   "id": "bed-b",
   "start": 30.61,
   "end": 34.15,
   "text": "Kita tengok ni ada point untuk lampu, untuk kipas."
  },
  {
   "id": "bath-a",
   "start": 34.15,
   "end": 36.41,
   "text": "Ni dia punya master"
  },
  {
   "id": "bath-b",
   "start": 36.41,
   "end": 37.01,
   "text": "bathroom."
  },
  {
   "id": "bath-c",
   "start": 37.01,
   "end": 39.089999999999996,
   "text": "Belum pasang toilet bowl dengan sinki."
  },
  {
   "id": "bath-d",
   "start": 39.089999999999996,
   "end": 40.79,
   "text": "Ok, ni bilik air nombor 2."
  },
  {
   "id": "rooms",
   "start": 40.79,
   "end": 45.35,
   "text": "Bilik nombor 2, 3 dan 4 dengan kawasan kitchen dia."
  },
  {
   "id": "usp-a",
   "start": 45.35,
   "end": 48.95,
   "text": "So, dia privasi sikit sebab living hall tak"
  },
  {
   "id": "usp-b",
   "start": 48.95,
   "end": 50.910000000000004,
   "text": "bersambung dengan area"
  },
  {
   "id": "usp-c",
   "start": 50.910000000000004,
   "end": 51.78,
   "text": "dapur."
  },
  {
   "id": "usp-d",
   "start": 51.78,
   "end": 52.72,
   "text": "Senang sikit."
  },
  {
   "id": "cta-a",
   "start": 52.72,
   "end": 56.54,
   "text": "Kalau berminat dengan projek ni, korang boleh contact saya di 016"
  },
  {
   "id": "cta-b",
   "start": 56.54,
   "end": 58.32,
   "text": "370 8908."
  }
